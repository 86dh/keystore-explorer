    </tr>
    <tr>
      <td class="plain_even">SHA-512 with DSA</td>
    </tr>
    <tr>
      <td class="plain_odd align-top" rowspan="15">RSA</td>
      <td class="plain_odd align-top" rowspan="15">512 - 16384</td>
      <td class="plain_odd">MD2 with RSA</td>
    </tr>
    <tr>
      <td class="plain_odd">MD5 with RSA</td>
    </tr>
    <tr>
